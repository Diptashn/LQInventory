def _load_inventory_sheet_id() -> str:
    """Read stored inventory sheet ID from file, or return empty string."""
    try:
        with open(INVENTORY_SHEET_FILE, "r") as f:
            return f.read().strip()
    except Exception:
        return ""


def _store_inventory_sheet_id(sid: str) -> None:
    """Persist inventory sheet ID for later reuse."""
    with open(INVENTORY_SHEET_FILE, "w") as f:
        f.write(sid)


def get_or_create_inventory_sheet(svc) -> str:
    """Return spreadsheetId for the Inventory sheet, creating it if needed."""
    sid = _load_inventory_sheet_id()
    if sid:
        # verify exists
        try:
            svc.spreadsheets().get(spreadsheetId=sid, fields="spreadsheetId").execute()
            return sid
        except Exception:
            # maybe deleted, fall through to create
            pass
    # create new spreadsheet
    body = {"properties": {"title": INVENTORY_SHEET_TITLE}}
    new_sheet = svc.spreadsheets().create(body=body).execute()
    sid = new_sheet.get("spreadsheetId")
    _store_inventory_sheet_id(sid)
    return sid


def fix_month_merges_and_formatting(svc, sid: str, tab: str) -> Dict[str, Any]:
    """Repair month-header merges and re-apply consistent colours on one tab.

    The sheet previously had merges/formatting written with a BLOCK_ROWS of 37
    while the real block stride is 38, so every month from Februari onward was
    merged one row too high and the header colours landed on the wrong rows.

    Steps:
      1. read existing merges and drop the ones that are not at a real month
         header row (0-based multiple of BLOCK_ROWS)
      2. clear stale fills/alignment across the whole used range so leftover
         colour bands from the old 37-row layout disappear
      3. re-merge A:F on every month header row and re-apply the standard
         month/column-header/summary styling at the correct offsets
    """
    sheet_id = get_sheet_id(svc, sid, tab)

    meta = svc.spreadsheets().get(
        spreadsheetId=sid, fields="sheets.properties").execute()
    for s in meta["sheets"]:
        if s["properties"]["sheetId"] == sheet_id:
            grid_rows = s["properties"].get("gridProperties", {}).get("rowCount", 1000)
            break

    valid_starts = {(m - 1) * BLOCK_ROWS for m in range(1, 13)}
    bad = [m for m in _get_merges(svc, sid, sheet_id)
           if (m["startRowIndex"], m["endRowIndex"], m["startColumnIndex"],
               m["endColumnIndex"]) not in
           {(b, b + 1, 0, 6) for b in valid_starts}]

    requests: list = []
    # Unmerge any existing merge regions across the whole sheet first.
    requests.append({"unmergeCells": {"range": {
        "sheetId": sheet_id,
        "startRowIndex": 0, "endRowIndex": grid_rows,
        "startColumnIndex": 0, "endColumnIndex": 6}}})

    # Bad merges list is kept only for reporting; all merges are already cleared.
    # Wipe stale fills and bold across the whole sheet so colour bands written
    # at the old 37-row offsets disappear completely. (Alignment cannot be set
    # to "CLEAR" via the API, so we leave it and let the per-block repeatCell
    # calls below overwrite it with the correct values.)
    requests.append({"repeatCell": {"range": {
        "sheetId": sheet_id, "startRowIndex": 0, "endRowIndex": grid_rows,
        "startColumnIndex": 0, "endColumnIndex": 6},
        "cell": {"userEnteredFormat": {
            "backgroundColor": {}, "textFormat": {"bold": False}}},
        "fields": "userEnteredFormat(backgroundColor,textFormat.bold)"}})
    # No borders either, so old block borders at 37-offsets vanish.
    requests.append({"updateBorders": {"range": {
        "sheetId": sheet_id, "startRowIndex": 0, "endRowIndex": grid_rows,
        "startColumnIndex": 0, "endColumnIndex": 6},
        "top": None, "bottom": None, "left": None, "right": None,
        "innerHorizontal": None, "innerVertical": None}})

    for m in range(1, 13):
        requests.extend(_block_requests(sheet_id, m))

    # Column widths
    for c, w in enumerate([55, 230, 120, 120, 130, 130]):
        requests.append({"updateDimensionProperties": {"range": {
            "sheetId": sheet_id, "dimension": "COLUMNS",
            "startIndex": c, "endIndex": c + 1},
            "properties": {"pixelSize": w}, "fields": "pixelSize"}})

    svc.spreadsheets().batchUpdate(
        spreadsheetId=sid, body={"requests": requests}).execute()
    return {"tab": tab, "sheet_id": sheet_id,
            "unmerged": len(bad), "merged": 12}


def _get_merges(svc, sid: str, sheet_id: int) -> List[dict]:
    """Return the merge regions of one sheet."""
    meta = svc.spreadsheets().get(
        spreadsheetId=sid, fields="sheets.properties.sheetId,sheets.merges").execute()
    for s in meta["sheets"]:
        if s["properties"]["sheetId"] == sheet_id:
            return s.get("merges", [])
    return []



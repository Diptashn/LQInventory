# Cache of config tab name -> live sheet title, so casing drift in the sheet
# (e.g. "cupcake 18pcs" vs "CUPCAKE 18 Pcs") does not break A1 notation.
_TAB_TITLE_CACHE: Optional[Dict[str, str]] = None


def resolve_tab_name(svc, sid: str, tab: str) -> Optional[str]:
    """Return the sheet's real tab title matching `tab` (case/space-insensitive).

    The config file stores hand-typed names; the live sheet may differ in casing
    ("cupcake 18pcs" -> "CUPCAKE 18 Pcs"). A1 ranges are case-sensitive, so we
    always resolve to the real title. Returns None when the tab does not exist.
    """
    global _TAB_TITLE_CACHE
    if _TAB_TITLE_CACHE is None:
        meta = svc.spreadsheets().get(spreadsheetId=sid).execute()
        _TAB_TITLE_CACHE = {s["properties"]["title"] for s in meta.get("sheets", [])}
    norm = lambda s: "".join(s.split()).upper()
    target = norm(tab)
    for title in _TAB_TITLE_CACHE:
        if norm(title) == target:
            return title
    return None


# ── 1. sync sheet → database ─────────────────────────────────────────────
def sync_sheet_to_db(con: sqlite3.Connection) -> Dict[str, Any]:
    """
    Read every product tab in the sheet.
    For each unique bahan (row col B), record harga_kg (col C) in inventory table
    and write/update sheet_sync_log (per-product-per-month tracking).
    Returns dict: {bahan_name: harga_kg} that were synced.
    """
    if not PRODUCT_TABS:
        return {}
    svc = _get_service()
    sid = "1wA5WN0evR5VpMujKphfY7441T80bEz6OjH0EOnOW1JA"

    synced: Dict[str, Any] = {}
    now_iso = datetime.now(timezone.utc).replace(microsecond=0).isoformat() + "Z"

    for tab in SYNC_TABS:
        # Read all rows from the tab; each month block = 13 rows (header, colhead, 10 data, blank)
        r = svc.spreadsheets().values().get(
            spreadsheetId=sid, range=f"'{tab}'!A1:F200"
        ).execute()
        rows = r.get("values", [])

        if not rows or len(rows) < 3:
            continue

        # Month N (1-indexed) occupies rows:  1 + (N-1)*13  to  13 + (N-1)*13  (1-indexed inclusive)
        # Data rows within month block are rows 3..12 (1-indexed), i.e. 0-based indices 2..11 from block start
        # But we just loop all rows, skip headers row 1, and tag month by:
        #   month_block = (row_index_0based // 13) + 1
        # where row_index_0based = row_number - 1

        for r_idx_0based, row in enumerate(rows):
            if len(row) < 3:
                continue
            row_1based = r_idx_0based + 1
            month_block = (r_idx_0based // 13) + 1  # 1..12

            if month_block < 1 or month_block > 12:
                continue

            # Skip row 1 (month header merged cell) and row 2 (col headers)
            if row_1based <= 2:
                continue

            bahan_raw = row[1].strip() if len(row) > 1 else ""
            # Skip summary rows
            upper = bahan_raw.upper()
            if upper in ["TOTAL BAHAN", "ONGKOS PRODUKSI", "TOTAL MODAL", "TOTAL ESTIMASI", "MARGIN", "ESTIMASI AWAL"]:
                continue
            if not bahan_raw or upper == "NO.":
                continue

            bahan_title = bahan_raw.lower().title()
            if bahan_title not in BAHAN_SORTED:
                pass  # still record

            # harga_kg in col C (index 2, 0-based)
            harga_str = row[2].strip() if len(row) > 2 else ""
            harga_kg = parse_rp(harga_str)

            # Only sync if changed or new
            key = f"{tab}:{bahan_title}:M{month_block:02d}"
            existing = con.execute(
                "SELECT pemakaian_gram, harga_kg, updated_at FROM sheet_sync_log WHERE log_key=?",
                (key,),
            ).fetchone()

            if existing and existing[0] == harga_kg and existing[1] == harga_kg:
                continue  # unchanged

            # Upsert into inventory if not exists
            cur_item = con.execute(
                "SELECT id, name, unit_cost FROM inventory WHERE name=?",
                (bahan_title,),
            ).fetchone()

            if not cur_item:
                con.execute(
                    "INSERT INTO inventory (name, qty, unit_cost, updated_at) VALUES (?, 0, ?, ?)",
                    (bahan_title, harga_kg, now_iso),
                )
                con.execute(
                    "INSERT INTO sheet_sync_log (log_key, product_tab, bahan_name, month_num, harga_kg, pemakaian_gram, updated_at) VALUES (?, ?, ?, ?, ?, 0, ?)",
                    (key, tab, bahan_title, month_block, harga_kg, now_iso),
                )
                synced[bahan_title] = harga_kg
            else:
                # Update inventory unit_cost if changed
                if cur_item["unit_cost"] != harga_kg:
                    con.execute(
                        "UPDATE inventory SET unit_cost=?, updated_at=? WHERE name=?",
                        (harga_kg, now_iso, bahan_title),
                    )
                # Upsert sync log
                con.execute(
                    "UPDATE sheet_sync_log SET harga_kg=?, pemakaian_gram=?, updated_at=? WHERE log_key=?",
                    (harga_kg, 0, now_iso, key),
                )
                synced[bahan_title] = harga_kg

        con.commit()

    return synced


def parse_rp(s: str) -> float:
    """Parse Indonesian Rupiah like ' Rp 15,000.00 ' -> 15000. Keeps decimals. Guards insane vals."""
    if not s:
        return 0.0
    s = s.strip().replace("Rp", "").replace("RP", "").strip()
    if not s or s in ["-", "", "#N/A", "-   "]:
        return 0.0
    # Rp uses comma = thousand, dot = decimal
    s = s.replace(",", "")
    s = s.strip()
    try:
        val = float(s)
        if val > 100_000_000:  # sanity guard (not real price)
            return 0.0
        return val
    except ValueError:
        return 0.0


# ── 2. sync database → sheet ─────────────────────────────────────────────
def sync_inventory_sheet(con: sqlite3.Connection) -> str:
    """Push inventory DB rows to a dedicated "Inventory" Google Sheet.
    Columns: ID, Name, Qty (grams), Harga/KG, Harga/Gr, Product Tab, Updated At (WIB dd/mm/yyyy).
    Harga/Gr = Harga/KG / 1000 to mirror COGS sheet layout.
    Returns the sheet URL.
    """
    from datetime import timezone as _tz, timedelta as _td
    WIB = _tz(_td(hours=7))

    def _wib_ddmmyyyy(iso_str: str) -> str:
        """Convert stored UTC ISO timestamp to WIB dd/mm/yyyy."""
        try:
            s = (iso_str or "").replace("Z", "+00:00")
            dt = datetime.fromisoformat(s)
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=_tz.utc)
            return dt.astimezone(WIB).strftime("%d/%m/%Y")
        except Exception:
            return iso_str or ""

    svc = _get_service()
    sid = get_or_create_inventory_sheet(svc)
    # Prepare values: header + rows
    header = [["ID", "Name", "Qty (grams)", "Harga/KG", "Harga/Gr", "Updated At"]]
    rows = []
    for r in con.execute("SELECT id, name, qty, unit_cost, updated_at FROM inventory").fetchall():
        harga_kg = float(r[3] or 0)
        harga_gr = round(harga_kg / 1000.0, 2)
        rows.append([
            str(r[0]), r[1], str(r[2]), str(harga_kg), str(harga_gr), _wib_ddmmyyyy(r[4]),
        ])
    body = {"valueInputOption": "USER_ENTERED", "data": [{"range": "A1:F1", "values": header}]}
    # Write header
    svc.spreadsheets().values().batchUpdate(spreadsheetId=sid, body=body).execute()
    # Clear old data range
    svc.spreadsheets().values().clear(spreadsheetId=sid, range="A2:F1000").execute()
    # Write data starting at A2
    if rows:
        data_body = {"valueInputOption": "USER_ENTERED", "data": [{"range": f"A2:F{len(rows)+1}", "values": rows}]}
        svc.spreadsheets().values().batchUpdate(spreadsheetId=sid, body=data_body).execute()
    # Return public URL (published link)
    return f"https://docs.google.com/spreadsheets/d/{sid}"


# ── 2b. legacy sync to product tabs (for COGS sheet) ─────────────────────
SHEET_ID = "1wA5WN0evR5VpMujKphfY7441T80bEz6OjH0EOnOW1JA"
SYNC_TABS = [t for t in PRODUCT_TABS if t != "Inventory"]

def sync_db_to_sheet(con: sqlite3.Connection) -> Dict[str, int]:
    """
    Read inventory table, write harga_kg+harga_gram to every product tab
    where a matching bahan name exists. Returns count of cells updated.
    """
    if not PRODUCT_TABS:
        return {}
    svc = _get_service()
    sid = "1wA5WN0evR5VpMujKphfY7441T80bEz6OjH0EOnOW1JA"

    updated = 0
    now_iso = datetime.now(timezone.utc).replace(microsecond=0).isoformat() + "Z"

    inventory_rows = con.execute("SELECT id, name, unit_cost, product_tab, updated_at FROM inventory WHERE unit_cost > 0").fetchall()

    for tab in SYNC_TABS:
        real = resolve_tab_name(svc, sid, tab)
        if not real:
            continue
        # First, read current sheet to know row positions
        r = svc.spreadsheets().values().get(
            spreadsheetId=sid, range=f"'{real}'!A1:F200"
        ).execute()
        rows = r.get("values", [])

        # Build lookup: map bahan name (lowercase) -> its sheet rows (1-indexed).
        # Deliberately geometry-agnostic: we scan the whole tab and match by the
        # name in column B, so a change to N_BAHAN / BLOCK_ROWS can never make
        # us write prices to the wrong row.
        bahan_positions: Dict[str, List[int]] = {}
        for r_idx_0based, row in enumerate(rows):
            if len(row) < 3:
                continue
            if r_idx_0based < 2:
                continue  # month header + column header
            bahan_raw = row[1].strip() if len(row) > 1 else ""
            upper = bahan_raw.upper()
            if upper in ["TOTAL BAHAN", "ONGKOS PRODUKSI", "TOTAL MODAL", "TOTAL ESTIMASI",
                         "MARGIN", "ESTIMASI AWAL", "NO."]:
                continue
            if not bahan_raw:
                continue
            bahan_positions.setdefault(bahan_raw.lower(), []).append(r_idx_0based + 1)

        # Now update from inventory
        for inv in inventory_rows:
            name = inv[1]
            harga_kg = round(float(inv[2]), 2)
            harga_gram = round(harga_kg / 1000, 6)
            item_tab = inv[3] if inv[3] else None
            # If item is tagged to a specific product tab, only push there
            if item_tab and item_tab != tab:
                continue
            if name.lower() not in bahan_positions:
                continue
            for sheet_row in bahan_positions[name.lower()]:
                body = {"valueInputOption": "USER_ENTERED", "data": [{"range": f"'{real}'!C{sheet_row}:D{sheet_row}", "values": [[harga_kg, harga_gram]]}]}
                try:
                    svc.spreadsheets().values().batchUpdate(spreadsheetId=sid, body=body).execute()
                    updated += 1
                except Exception as e:
                    print(f"Error updating {tab} row {sheet_row}: {e}")

    con.commit()
    return {"cells_updated": updated}



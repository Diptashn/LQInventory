# New sheet utilities for Estimate tab

from app import database as dbmod

def sync_estimate_sheet(con: sqlite3.Connection, month_num: int, tab: str) -> str:
    """Write estimate entries for month to given product tab, clearing old item rows but preserving summary rows.
    Columns: NO, Nama, Qty (grams), Harga/KG, Harga/Gr, Harga Total (formula).
    """
    from app import sheets as gsheets
    svc = gsheets._get_service()
    # Ensure tab exists (already exists in product tabs)
    # Clear old item rows (keep summary rows)
    start = (month_num - 1) * gsheets.BLOCK_ROWS + 1  # month header row (1-indexed)
    # Data rows range: rows start+2 to start+11 (10 rows)
    clear_range = f"'{tab}'!A{start+2}:F{start+11}"
    svc.spreadsheets().values().clear(spreadsheetId=gsheets.INVENTORY_SHEET_ID, range=clear_range).execute()
    # Gather estimate entries for this month/tab
    rows = dbmod.get_estimate_entries(con, month_num)
    # Filter for this tab
    rows = [r for r in rows if r["product_tab"] == tab]
    values = []
    for i, r in enumerate(rows, start=1):
        inv = dbmod.get_item(con, r["item_id"])
        harga_kg = inv["unit_cost"] if inv else 0
        harga_gr = round(harga_kg / 1000, 2)
        formula = f"=C{start + i + 1}*D{start + i + 1}"  # total = qty * harga per kg
        values.append([i, r["item_name"], r["qty_used"], harga_kg, harga_gr, formula])
    if values:
        svc.spreadsheets().values().update(
            spreadsheetId=gsheets.INVENTORY_SHEET_ID,
            range=f"'{tab}'!A{start+2}:F{start+1+len(values)}",
            valueInputOption="USER_ENTERED",
            body={"values": values},
        ).execute()
    return f"https://docs.google.com/spreadsheets/d/{gsheets.INVENTORY_SHEET_ID}"